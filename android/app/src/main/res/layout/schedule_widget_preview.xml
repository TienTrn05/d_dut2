<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Android.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Android.AppWidgetContainer">
	<LinearLayout
        android:id="@+id/scheduleContainerPreview"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical">
		<LinearLayout
            android:id="@+id/date_sectionPreview"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
			<TextView
                android:id="@+id/tvWeekdayPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_weekday"
                android:contentDescription="@string/schedule_widget_weekday"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"/>
			<TextView
                android:id="@+id/tvMonthPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_month"
                android:contentDescription="@string/schedule_widget_month"
                android:textSize="14sp"
                android:textColor="#555555"/>
			<TextView
                android:id="@+id/tvDayPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_day"
                android:contentDescription="@string/schedule_widget_day"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#2979FF"/>
		</LinearLayout>

		<LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
                <LinearLayout
                android:id="@+id/divider"
                android:orientation="vertical"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E7F1F9" />
        </LinearLayout>

		<LinearLayout
        android:id="@+id/llScheduleItems"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">
			<!-- Item 1 -->
			<LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/schedule_item_bg">
				<TextView
                android:id="@+id/tvSubjectName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_subject_name"
                android:contentDescription="@string/schedule_widget_subject_name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000" />
				<RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
					<TextView
                    android:id="@+id/tvTime1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/schedule_widget_time"
                    android:contentDescription="@string/schedule_widget_time"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:ellipsize="end"
                    android:maxLines="1" />
					<TextView
                    android:id="@+id/tvRoom1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/schedule_widget_room"
                    android:contentDescription="@string/schedule_widget_room"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#747474"
                    android:ellipsize="start"
                    android:maxLines="1"/>
				</RelativeLayout>
			</LinearLayout>
			<!-- Item 2 -->
			<LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/schedule_item_bg">
				<TextView
                android:id="@+id/tvSubjectName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_subject_name"
                android:contentDescription="@string/schedule_widget_subject_name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000" />
				<RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
					<TextView
                    android:id="@+id/tvTime2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/schedule_widget_time"
                    android:contentDescription="@string/schedule_widget_time"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:ellipsize="end"
                    android:maxLines="1" />
					<TextView
                    android:id="@+id/tvRoom2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/schedule_widget_room"
                    android:contentDescription="@string/schedule_widget_room"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#747474"
                    android:ellipsize="start"
                    android:maxLines="1"/>
				</RelativeLayout>
			</LinearLayout>
			<!-- Item 3 -->
			<LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:background="@drawable/schedule_item_bg">
				<TextView
                android:id="@+id/tvSubjectName3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_subject_name"
                android:contentDescription="@string/schedule_widget_subject_name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000" />
				<RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
					<TextView
                    android:id="@+id/tvTime3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/schedule_widget_time"
                    android:contentDescription="@string/schedule_widget_time"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:ellipsize="end"
                    android:maxLines="1" />
					<TextView
                    android:id="@+id/tvRoom3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/schedule_widget_room"
                    android:contentDescription="@string/schedule_widget_room"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#747474"
                    android:ellipsize="start"
                    android:maxLines="1"/>
				</RelativeLayout>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</RelativeLayout>