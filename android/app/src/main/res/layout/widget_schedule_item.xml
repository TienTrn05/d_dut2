<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp"
    android:background="@drawable/schedule_item_bg">

    <TextView
        android:id="@+id/tvSubjectName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/schedule_widget_subject_name"
        android:contentDescription="@string/schedule_widget_subject_name"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/schedule_widget_time"
                android:contentDescription="@string/schedule_widget_time"
                android:textSize="13sp"
                android:textColor="#000000"
                android:ellipsize="end"
                android:maxLines="1" />
            <TextView
                android:id="@+id/tvRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/schedule_widget_room"
                android:contentDescription="@string/schedule_widget_room"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#747474"
                android:ellipsize="start"
                android:maxLines="1"/>
    </RelativeLayout>
</LinearLayout>