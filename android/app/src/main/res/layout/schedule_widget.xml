<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Android.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Android.AppWidgetContainer">

    <LinearLayout
        android:id="@+id/scheduleContainer"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/date_section"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvWeekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_weekday"
                android:contentDescription="@string/schedule_widget_weekday"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_month"
                android:contentDescription="@string/schedule_widget_month"
                android:textSize="14sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_widget_day"
                android:contentDescription="@string/schedule_widget_day"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#2979FF"/>
        </LinearLayout>
        
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
                <LinearLayout
                android:id="@+id/divider"
                android:orientation="vertical"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E7F1F9" />
        </LinearLayout>

    <ListView
        android:id="@+id/lvSchedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/scheduleContainer"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"/>
    </LinearLayout>

</RelativeLayout>