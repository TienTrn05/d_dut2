# Server only. Do not add a VITE_ prefix to secrets.
# Paste the SSO signing secret as UTF-8 text, inside quotes.
SSO_JWT_SECRET=""
# Shared-secret algorithms: HS256, HS384, HS512. Match the SSO server.
SSO_JWT_ALGORITHM=HS256
# Optional: copy the exact issuer/audience from the SSO server configuration.
SSO_JWT_ISSUER=""
SSO_JWT_AUDIENCE=""

# Use the API key that belongs to the selected notification environment.
PUSH_NOTIFICATIONS_API_URL=https://notifications.dut.udn.vn
PUSH_NOTIFICATIONS_API_KEY=""
# Development URL: https://notifications.dev.dut.navia.io.vn
